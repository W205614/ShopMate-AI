APP_PORT=18086
ADMIN_USERNAME=admin
# Required on first boot: 10-128 characters, letters and numbers. No default password.
ADMIN_PASSWORD=
APP_ORIGINS=http://localhost:18086,http://127.0.0.1:18086
# Set true when deploying behind HTTPS.
COOKIE_SECURE=false
# Backup directory on this host, independent of the api_data volume.
BACKUP_PATH=./backups
# Optional verified replica: requires an explicit Compose bind mount to /app/replica.
# Setting these values alone does not add a mount; see docs/monitoring.md.
# REPLICA_PATH=/absolute/host/replica-directory
# BACKUP_REPLICA_DIR=/app/replica
LOG_REQUESTS=true
AFTER_SALE_DAYS=7
ALLOW_LEGACY_COMMANDS=false

# Optional host-side monitor, started from backend/. No restart actions are performed.
# MONITOR_BASE_URL=http://127.0.0.1:18086
# MONITOR_COMPOSE_PROJECT=shopmate-ai
# MONITOR_API_CONTAINER=shopmate-ai-api-1
# MONITOR_WEB_CONTAINER=shopmate-ai-web-1
# Use the CURRENT owner password, not an obsolete first-boot ADMIN_PASSWORD.
# MONITOR_ADMIN_USERNAME=admin
# MONITOR_ADMIN_PASSWORD=
# Alternative to password login: an existing owner cookie; expiry triggers a failure.
# MONITOR_ADMIN_COOKIE=
# Comma-separated HOST paths for the actual data/backups storage; default is cwd.
# MONITOR_DISK_PATHS=
# MONITOR_MAINTENANCE_FILE=../.delivery/monitor-maintenance.json
# MONITOR_MAINTENANCE_UNTIL=
# Optional HTTPS webhook. Never commit its URL/token. Empty means alert delivery unconfigured.
# MONITOR_WEBHOOK_URL=

# AI is opt-in. Secrets stay in this ignored local .env; never prefix with VITE_.
AI_ENABLED=false
LLM_MODEL_ID=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
AI_PROVIDER_TIMEOUT_MS=30000
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE=20
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=3072
SEND_EMBEDDING_DIMENSIONS=false
RERANKER_ENABLED=true
RERANKER_MODEL=Pro/BAAI/bge-reranker-v2-m3
RERANKER_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=2
