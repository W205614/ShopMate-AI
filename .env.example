APP_PORT=18086
ADMIN_USERNAME=admin
# Required on first boot: 10-128 characters, letters and numbers. No default password.
ADMIN_PASSWORD=
APP_ORIGINS=http://localhost:18086,http://127.0.0.1:18086
# Set true when deploying behind HTTPS.
COOKIE_SECURE=false
# Backup directory on this host, independent of the api_data volume.
BACKUP_PATH=./backups
LOG_REQUESTS=true
AFTER_SALE_DAYS=7
ALLOW_LEGACY_COMMANDS=false
