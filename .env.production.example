# Copy to .env.production. Keep the real file private (chmod 600).
# This file is used ONLY by deploy/compose.production.yaml, never the local override.
SHOP_MODE=production
PUBLIC_URL=https://shop.example.com
DOMAIN=shop.example.com
ACME_EMAIL=operations@example.com
COMPOSE_PROJECT_NAME=shopmate-production
VCS_REF=REPLACE_WITH_VALIDATED_FULL_COMMIT_SHA
API_IMAGE=ghcr.io/your-account/shopmate-ai-api:REPLACE_WITH_VALIDATED_COMMIT
WEB_IMAGE=ghcr.io/your-account/shopmate-ai-web:REPLACE_WITH_VALIDATED_COMMIT
CADDY_IMAGE=caddy:2.11.9-alpine@sha256:71d41fe4b1ae92a058abc87afe614178b996d8a6b96d0f4c71ae30606e5927e3
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.2

# Absolute host paths. Prepare directories for the container UID/GID 1000.
SECRETS_PATH=/etc/shopmate-ai/secrets
PRODUCTION_STATE_PATH=/srv/shopmate-ai/runtime
BACKUP_PATH=/srv/shopmate-ai/backups
ASSET_PATH=/srv/shopmate-ai/assets
# Use an unused subnet; CADDY_IP must belong to it.
PROXY_SUBNET=10.254.86.0/24
PROXY_DYNAMIC_RANGE=10.254.86.128/25
CADDY_IP=10.254.86.2

ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/run/secrets/admin-password
ENCRYPTION_KEY_FILE=/run/secrets/encryption-key
MONITOR_TOKEN_FILE=/run/secrets/monitor-token
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_REQUESTS=true
ALLOW_DEMO_RESET=false
ALLOW_LEGACY_COMMANDS=false
AFTER_SALE_DAYS=7
BACKUP_RETENTION_MODE=internal

# Enable only products already opened on the merchant account. At least one is required.
PAYMENT_CHANNELS=alipay_page,alipay_wap
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat-private-key.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_FILE=/run/secrets/wechat-public-key.pem
WECHAT_API_V3_KEY_FILE=/run/secrets/wechat-api-v3-key
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay-private-key.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay-public-key.pem
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# At least SMTP email or Aliyun verification SMS must be enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_DAILY_LIMIT=500
SMS_ENABLED=false
# When SMS_ENABLED=true both verification and transaction templates are required.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_VERIFICATION=
ALIYUN_SMS_TEMPLATE_TRANSACTION=
SMS_TEMPLATE_VARIABLES_VERIFICATION={"code":"code"}
SMS_TEMPLATE_VARIABLES_TRANSACTION={"orderId":"orderId"}
SMS_DAILY_LIMIT=100

KUAIDI100_ENABLED=false
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_CALLBACK_SECRET=

ASSET_STORAGE=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=shopmate
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_S3_ENABLED=false
# Set only while copying objects from a previous S3 endpoint/account.
S3_SOURCE_ENDPOINT=
S3_SOURCE_ACCESS_KEY_ID=
S3_SOURCE_SECRET_ACCESS_KEY=

# Existing AI is optional; use the same server-side provider configuration as .env.example.
AI_ENABLED=false

# Optional host monitor and default-disabled observability profile.
MONITOR_BASE_URL=https://shop.example.com
MONITOR_DIAGNOSTICS_DOCKER=true
MONITOR_COMPOSE_PROJECT=shopmate-production
MONITOR_DISK_PATHS=/srv/shopmate-ai/backups,/srv/shopmate-ai/assets
MONITOR_WEBHOOK_URL=
