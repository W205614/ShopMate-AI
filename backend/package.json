  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "admin:password": "node --env-file-if-exists=../.env --import tsx src/admin-password.ts",
    "maintenance": "node --env-file-if-exists=../.env --import tsx src/maintenance.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
