{
  "name": "shopmate-ai-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "admin:password": "node --env-file-if-exists=../.env --import tsx src/admin.ts",
    "maintenance": "node --env-file-if-exists=../.env --import tsx src/maintenance.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "jszip": "^3.10.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
