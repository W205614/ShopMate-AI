{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-X-Powered-By
	}
	route {
		@internal path /api/internal/* /metrics
		respond @internal 404
		@maintenance file {
			root /srv/maintenance
			try_files active
		}
		respond @maintenance "商城正在维护，请稍后重试。" 503
		reverse_proxy web:80 {
			header_up X-Forwarded-Proto https
		}
	}
}
