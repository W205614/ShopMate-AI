resolver 127.0.0.11 valid=5s ipv6=off;
log_format shopmate escape=json '{"time":"$time_iso8601","requestId":"$request_id","method":"$request_method","path":"$uri","status":$status,"duration":$request_time}';
upstream shopmate_api {
    zone shopmate_api 64k;
    server api:3001 resolve;
    keepalive 32;
    keepalive_timeout 4s;
}
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    access_log /var/log/nginx/access.log shopmate;
    # Only the fixed edge peer may supply the client address; arbitrary public XFF is ignored.
    set_real_ip_from ${CADDY_IP}/32;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    location = /healthz { access_log off; return 200 "ok\n"; }
    location ^~ /api/internal/ { return 404; }
    location = /metrics { return 404; }
    location /api/ {
        proxy_pass http://shopmate_api;
        proxy_http_version 1.1;
        proxy_hide_header X-Content-Type-Options;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        client_max_body_size 15m;
    }
    location = /index.html {
        add_header Cache-Control no-store;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }
    location /assets/ { try_files $uri =404; expires 1y; }
    location /images/ { try_files $uri =404; expires 1d; }
    location / { try_files $uri $uri/ /index.html; }
}
